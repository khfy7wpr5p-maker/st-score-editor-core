    "staff_measure": ["keySignature", "clef"],
    "event_note_grace_semantics_preserved": true,
    "sparse": true,
    "same_revision": true
  },
  "addressing": {
    "measure_frame_kind": true,
    "descendant_paths_include_frame_id": true,
    "identity_uses_stable_ids": true,
    "instrument_separate_address_kind": false,
    "stale_revision_fails_closed": true,
    "linked_tab_has_canonical_measure_descendants": false
  },
  "migration": {
    "v2_to_v3_guarded": true,
    "preserve_existing_musical_entity_ids": true,
    "deterministic_noncolliding_frame_and_instrument_ids": true,
    "require_measure_count_ordinal_display_alignment": true,
    "misalignment_rejects": true,
    "frame_notation_conflict_rejects": true,
    "tab_clef_does_not_infer_linked_tab": true,
    "v3_to_v2_lossless_only": true,
    "linked_tab_blocks_v2_downgrade": true
  },
  "implemented_authoring": [
    "ADD_STANDARD_OR_PERCUSSION_PART",
    "REMOVE_PART",
    "REORDER_PART",
    "ADD_STANDARD_OR_PERCUSSION_STAFF",
    "REMOVE_CONTENT_STAFF",
    "REORDER_STAFF",
    "ADD_LINKED_TAB_STAFF",
    "REMOVE_LINKED_TAB_STAFF",
    "RENAME_PART_OR_INSTRUMENT"
