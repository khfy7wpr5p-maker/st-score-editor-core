  "add_content_staff_policy": {
    "invent_rhythmic_content": false,
    "requires_effective_meter_for_every_frame": true,
    "caller_supplies_measure_voice_rest_ids": true,
    "creates_one_explicit_full_frame_rest_per_frame": true,
    "missing_meter_fails_closed": true
  },
  "removal_policy": {
    "final_part_forbidden": true,
    "final_content_staff_forbidden": true,
    "notation_orphan_rejects": true,
    "nearest_target_rebinding": false,
    "implicit_cascade": false
  },
  "history_session": {
    "atomic_score_notation_snapshots": true,
    "direct_child_commit_only": true,
    "native_v3_session": true,
    "one_time_v2_to_v3_session_migration": true
  },
  "renderer": {
    "lossless_v3_to_v2_projection_reused": true,
    "unrepresentable_status": "V3_XML_PENDING",
    "unrepresentable_musicxml": null,
    "v3_native_topology_musicxml": false
