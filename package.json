{
  "name": "st-score-editor-core",
  "version": "0.0.0",
  "private": true,
  "description": "Security-first semantic score editing core for ScoreMosaic and Guitar TAB workspaces.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
