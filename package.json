{
  "name": "st-score-editor-core",
  "version": "0.0.0",
  "private": true,
  "description": "Security-first semantic score editing core for ScoreMosaic and Guitar TAB workspaces.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "build:browser": "npm run build && node scripts/build-browser.mjs && node scripts/build-professional-browser.mjs",
    "validate": "node scripts/validate-repo.mjs",
    "test": "npm run build:browser && node --test",
    "ci": "npm run validate && npm test"
  },
  "dependencies": {
    "saxes": "6.0.0",
    "xmlchars": "2.2.0"
  },
  "optionalDependencies": {
    "@st/score-audio-contracts": "https://github.com/khfy7wpr5p-maker/st-score-audio-engine/releases/download/v0.1.1/st-score-audio-contracts-0.1.0.tgz",
    "@st/score-audio-web": "https://github.com/khfy7wpr5p-maker/st-score-audio-engine/releases/download/v0.1.1/st-score-audio-web-0.1.1.tgz"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
