    "secondaryValidation": { "family": "Verovio-class", "admittedDependency": false }
  },
  "buildDependencies": { "typescript": { "version": "6.0.3", "runtime": false, "license": "Apache-2.0" } },
  "runtimeDependencies": {
    "saxes": { "version": "6.0.0", "license": "ISC", "authority": "XML_PARSER_ONLY" },
    "xmlchars": { "version": "2.2.0", "license": "MIT", "authority": "SAXES_SUPPORT_ONLY" }
  },
  "musicXml": {
    "isExchangeFormat": true,
    "isDirectEditorState": false,
    "safeImportRequired": true,
    "semanticRoundTripRequiredBeforeE2Close": true,
    "e2Subset": {
