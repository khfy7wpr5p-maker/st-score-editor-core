    "transactionVersion": "1.0.0",
    "maxCommandsPerTransaction": 256,
    "atomic": true,
    "baseRevisionRequired": true,
    "partialApplyAllowed": false,
    "canonicalValidationBeforeAcceptance": true,
    "supportedCommands": ["SET_NOTE_PITCH", "SET_EVENT_DURATION", "REPLACE_EVENT_WITH_REST", "REPLACE_REST_WITH_NOTE", "ADD_CHORD_TONE", "REMOVE_CHORD_TONE"]
  },
  "history": {
    "contractVersion": "1.0.0",
